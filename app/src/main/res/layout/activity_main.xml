<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Douane Temporelle"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/et_nomamin souaii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_naissanceamin souaii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de naissance (ex: 1990)"
        android:inputType="number"
        android:maxLength="4" />

    <EditText
        android:id="@+id/et_destinationamin souaii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Année de destination (ex: 2050)"
        android:inputType="number"
        android:maxLength="4" />

    <RadioGroup
        android:id="@+id/rg_motifamin souaii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rb_tourismeamin souaii"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tourisme" />

        <RadioButton
            android:id="@+id/rb_modifamin souaii"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modification du passé" />

        <RadioButton
            android:id="@+id/rb_fuiteamin souaii"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fuite" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_inspecteramin souaii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Inspecter le profil" />
</LinearLayout>
